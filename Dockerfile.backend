FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better caching)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ✅ PRE-DOWNLOAD THE EMBEDDING MODEL DURING BUILD
# This downloads the ~90MB model once, not on every cold start
RUN python -c "from sentence_transformers import SentenceTransformer; print('🔄 Downloading embedding model...'); model = SentenceTransformer('all-MiniLM-L6-v2'); print('✅ Model downloaded and cached!')"

# Copy application code
COPY src/ ./src/
COPY data/ ./data/

# Create necessary directories
RUN mkdir -p /app/data/resumes /app/data/embeddings

# Set Python path
ENV PYTHONPATH=/app

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "src.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]